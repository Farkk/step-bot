# Local defaults. Replace every credential before exposing this stack.
# Архивная конфигурация Go/VPS. Для Laravel + MySQL используйте backend/.env.example.
APP_ENV=local
APP_PORT=8080
POSTGRES_DB=step
POSTGRES_USER=step
POSTGRES_PASSWORD=step_local_only
S3_BUCKET=step-attachments
S3_ACCESS_KEY=step_local
S3_SECRET_KEY=step_local_secret
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=local_webhook_secret
PUBLIC_BASE_URL=http://localhost:8080
SESSION_SECRET=local_session_secret_replace_in_production
