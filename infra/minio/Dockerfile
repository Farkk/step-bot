# Official MinIO release binary; Docker Hub and Quay images may be unavailable.
FROM alpine:3.22 AS fetch
ARG TARGETARCH
RUN apk add --no-cache curl
RUN case "$TARGETARCH" in \
      arm64) checksum=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d ;; \
      amd64) checksum=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f ;; \
      *) exit 1 ;; \
    esac && \
    curl -fL --retry 3 -o /minio "https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-${TARGETARCH}.RELEASE.2025-09-07T16-13-09Z" && \
    echo "$checksum  /minio" | sha256sum -c - && chmod +x /minio

FROM alpine:3.22
COPY --from=fetch /minio /usr/local/bin/minio
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/minio"]
